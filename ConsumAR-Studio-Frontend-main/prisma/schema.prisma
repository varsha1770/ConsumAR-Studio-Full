generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String        @id @default(uuid()) @db.Uuid
  createdAt         DateTime      @default(now())
  email             String        @unique @map("email")
  lastLogin         DateTime?
  emailVerified     DateTime?
  image             String?
  name              String?
  phoneNumber       String?       @map("phone_number")
  gender            String?       @map("gender")
  bio               String?       @map("bio")
  comment           String?       @map("comment")
  rating            Int?          @default(5) @map("rating")
  country           String?       @map("country")
  tier              Tier          @default(FREE)
  isAdmin           Boolean       @default(false)
  // ── Super Admin discipline fields ──────────────────────────────────────────
  status            String        @default("active")
  adminNote         String        @default("") @map("admin_note")
  statusChangedAt   DateTime?     @map("status_changed_at")
  statusChangedBy   String?       @map("status_changed_by")
  isSuperAdmin      Boolean       @default(false) @map("is_super_admin")
  // ───────────────────────────────────────────────────────────────────────────
  accounts      Account[]
  sessions      Session[]
  activities    Activity[]
  history       HistoryItem[]
  settings      UserSettings?
  paidDetails   PaidUser?
  authRequests  AuthRequest[]

  @@map("Users")
  @@index([email])
  @@index([tier])
  @@index([isAdmin])
  @@index([status])
}

model UserSettings {
  id            String   @id @default(cuid())
  userId        String   @unique @db.Uuid
  glbFile       String?
  usdzFile      String?
  glbFileKey    String?
  usdzFileKey   String?
  glbFileName   String?
  dimensions    Json?
  dimensionUnit String?
  scaleValue    String?
  updatedAt     DateTime @updatedAt
  userEmail     String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model HistoryItem {
  id            String   @id @default(cuid())
  userId        String   @db.Uuid
  fileName      String
  action        String
  details       String?
  glbFile       String?
  usdzFile      String?
  createdAt     DateTime @default(now())
  downloadCount Int      @default(0)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("history_items")
}

model Activity {
  id            String   @id @default(cuid())
  userId        String?  @db.Uuid
  type          String
  fileName      String
  createdAt     DateTime @default(now())
  glbFile       String?
  usdzFile      String?
  downloadCount Int      @default(0)
  ipAddress     String?
  userEmail     String?
  user          User?    @relation(fields: [userId], references: [id])

  @@map("activities")
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([ipAddress])
  @@index([userEmail])
}

enum Tier {
  NON_LOGGED
  FREE
  PAID
}

model GuestUsage {
  id           String   @id @default(uuid()) @db.Uuid
  ipAddress    String
  macAddress   String?  // Unique identifier (Fingerprint/MAC equivalent)
  rescaleCount Int      @default(0)
  uploadCount  Int      @default(0)
  usdzCount    Int      @default(0)
  generate3dCount Int   @default(0)
  lastUsage    DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("GuestUsage")
  @@index([ipAddress, macAddress])
}

model SampleUsage {
  id           String   @id @default(uuid()) @db.Uuid
  ipAddress    String
  macAddress   String?
  uploadCount  Int      @default(0)
  rescaleCount Int      @default(0)
  usdzCount    Int      @default(0)
  lastUsage    DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("SampleUsage")
  @@index([ipAddress, macAddress])
}

model PaidUser {
  id                   String   @id @db.Uuid
  dailyUploadCount     Int      @default(0)
  dailyRescaleCount    Int      @default(0)
  monthlyRescaleCount  Int      @default(0)
  historyDownloadCount Int      @default(0)
  dailyGenerate3dCount Int      @default(0)
  validityTimer        DateTime @default(now()) 
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("PaidUsers")
  @@index([id, validityTimer])
}

model FeatureConfig {
  tier                 Tier     @id
  dailyUploadLimit     Int
  dailyRescaleLimit    Int
  monthlyRescaleLimit  Int
  dailyUsdzLimit       Int
  monthlyUsdzLimit     Int
  historyDownloadLimit Int
  dailyGenerate3dLimit Int      @default(5)
  allowedUnits         String[]
  isUsdzUnlimited      Boolean  @default(false)

  @@map("FeatureConfig")
}

model SampleConfig {
  id                Int      @id @default(1)
  dailyUploadLimit  Int      @default(50)
  dailyRescaleLimit Int      @default(20)
  dailyUsdzLimit    Int      @default(10)

  @@map("SampleConfig")
}

model AuthRequest {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String
  otpHash    String
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserActivitySummary {
  id                      Int       @id @default(1)
  totalGoogleLogins       Int       @default(0) @map("total_google_logins")
  totalMagicLinkLogins    Int       @default(0) @map("total_magic_link_logins")
  totalStandardEmails     Int       @default(0) @map("total_standard_emails")
  totalPaidUsers          Int       @default(0) @map("total_paid_users")
  totalFreeUsers          Int       @default(0) @map("total_free_users")
  totalGuestUsers         Int       @default(0) @map("total_guest_users")
  totalActivities         Int       @default(0) @map("total_activities")
  totalHistoryItems       Int       @default(0) @map("total_history_items")

  totalPaidActivities     Int       @default(0) @map("total_paid_activities")
  totalMagicActivities    Int       @default(0) @map("total_magic_activities")
  totalGoogleActivities   Int       @default(0) @map("total_google_activities")
  totalGuestActivities          Int       @default(0) @map("total_guest_activities")
  totalStandardEmailActivities  Int       @default(0) @map("total_standard_email_activities")

  totalPaidHistory              Int       @default(0) @map("total_paid_history")
  totalMagicHistory             Int       @default(0) @map("total_magic_history")
  totalGoogleHistory            Int       @default(0) @map("total_google_history")
  totalGuestHistory             Int       @default(0) @map("total_guest_history")
  totalStandardEmailHistory     Int       @default(0) @map("total_standard_email_history")

  total_sample_uploads          Int       @default(0)
  total_sample_rescales         Int       @default(0)
  total_sample_usdz             Int       @default(0)

  lastUpdated                   DateTime  @default(now()) @updatedAt @map("last_updated")

  gen3dUploadStatsId            Int?      @unique @map("gen3d_upload_stats_id")
  gen3dUploadStats              Gen3dUploadStats? @relation(fields: [gen3dUploadStatsId], references: [id])

  @@map("user_activity_summary")
}

model PlatformStats {
  id                Int      @id @default(1)
  totalGuests       Int      @default(0) @map("total_guests")
  totalGoogleLogins Int      @default(0) @map("total_google_logins")
  totalMagicLogins  Int      @default(0) @map("total_magic_logins")
  totalPaidUsers    Int      @default(0) @map("total_paid_users")
  lastUpdated       DateTime @updatedAt @map("last_updated")

  @@map("platform_stats")
}

model GenConfig {
  tier            Tier     @id
  dailyLimit      Int
}

model Gen3dUploadStats {
  id            Int      @id @default(1)
  total_uploads Int      @default(0)
  last_updated  DateTime @default(now())
  userActivitySummary UserActivitySummary?
}
